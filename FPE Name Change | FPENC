local running = false
local randomMode = false
local antiTagEnabled = false
local hue = 0
local currentRandomName = nameBox.Text
local alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

local function generateRandomName()
    local base = nameBox.Text

    if base == "" then
        base = "Tim3craft"
    end

    local extra = ""

    for i = 1, math.random(1, 3) do
        local n = math.random(1, #alphabet)
        extra ..= alphabet:sub(n, n)
    end

    local position = math.random(1, #base + 1)

    return base:sub(1, position - 1)
        .. extra
        .. base:sub(position)
end

local function getName()
    if randomMode then
        return currentRandomName
    end

    return nameBox.Text
end

local function updateOverhead(text, color)
    remote:FireServer(
        text,
        "",
        Enum.Font.Arial,
        color,
        color
    )
end

randomToggle.MouseButton1Click:Connect(function()
    randomMode = not randomMode

    randomToggle.Text = randomMode
        and "Random Characters: ON"
        or "Random Characters: OFF"

    randomToggle.BackgroundColor3 = randomMode
        and Color3.fromRGB(100, 100, 100)
        or Color3.fromRGB(55, 55, 55)

    currentRandomName = generateRandomName()
    preview.Text = getName()
end)

regenerate.MouseButton1Click:Connect(function()
    currentRandomName = generateRandomName()
    preview.Text = getName()
end)

nameBox:GetPropertyChangedSignal("Text"):Connect(function()
    if not randomMode then
        preview.Text = nameBox.Text
    else
        currentRandomName = generateRandomName()
        preview.Text = currentRandomName
    end
end)

antiTagButton.MouseButton1Click:Connect(function()
    antiTagEnabled = not antiTagEnabled

    antiTagButton.Text = antiTagEnabled
        and "ANTI-TAG CHECK: ON"
        or "ANTI-TAG CHECK: OFF"

    antiTagButton.BackgroundColor3 = antiTagEnabled
        and Color3.fromRGB(100, 100, 100)
        or Color3.fromRGB(60, 60, 60)

    if antiTagEnabled then
        if #getName() > 20 then
            status.Text = "Warning: Try a shorter name. Roblox filtering still applies."
        else
            status.Text = "Name length checked. Roblox filtering still applies."
        end
    else
        status.Text = running and "Status: RAINBOW ON" or "Status: STOPPED"
    end
end)

start.MouseButton1Click:Connect(function()
    if running then
        return
    end

    running = true
    status.Text = "Status: SMOOTH RAINBOW ON"

    task.spawn(function()
        local sendElapsed = 0
        local randomElapsed = 0

        while running and gui.Parent do
            local dt = RunService.RenderStepped:Wait()

            sendElapsed += dt
            randomElapsed += dt

            -- Smooth rainbow; one complete hue cycle about every 0.67 seconds.
            hue = (hue + dt * 1.5) % 1

            if randomMode and randomElapsed >= 0.5 then
                randomElapsed = 0
                currentRandomName = generateRandomName()
            end

            local color = Color3.fromHSV(hue, 1, 1)
            local name = getName()

            preview.Text = name
            preview.TextColor3 = color
            stroke.Color = Color3.fromHSV((hue + 0.12) % 1, 1, 1)

            -- Limit server updates to approximately 6–7 per second.
            if sendElapsed >= 0.15 then
                sendElapsed = 0
                updateOverhead(name, color)
            end
        end
    end)
end)

stop.MouseButton1Click:Connect(function()
    running = false
    status.Text = "Status: STOPPED"
end)

close.MouseButton1Click:Connect(function()
    running = false
    gui:Destroy()
end)
